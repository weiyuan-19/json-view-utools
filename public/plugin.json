{
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "pluginSetting": {
    "height": 620,
    "single": false
  },
  "features": [
    {
      "code": "json-editor",
      "explain": "编辑、格式化和转换 JSON",
      "cmds": [
        "JSON 编辑器",
        "Json",
        "json-view",
        {
          "type": "regex",
          "label": "编辑 JSON",
          "match": "/^\\s*(?:\\{[\\s\\S]*\\}|\\[[\\s\\S]*\\])\\s*$/",
          "minLength": 2,
          "maxLength": 100000
        },
        {
          "type": "files",
          "label": "编辑 JSON 文件",
          "fileType": "file",
          "extensions": ["json"],
          "maxLength": 1
        }
      ]
    }
  ]
}
